{
  "manifest_version": 3,
  "name": "SE-Billing",
  "version": "2.11.0",
  "description": "Auto-fill ค่าบริการ I Survey ตามจังหวัด/อำเภอ/ประเภทเคลม + บันทึก log + dashboard งานค้างต่อหัวหน้า",
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://cloud.isurvey.mobi/*",
    "https://*.isurvey.mobi/*",
    "https://*.appspot.com/*",
    "https://billing.sesurvey.cloud/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SE-Billing — เลือกจังหวัด",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://cloud.isurvey.mobi/*",
        "https://se-web-prodv2-dot-isurvey-se-gcp.as.r.appspot.com/*"
      ],
      "js": [
        "loader.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": false
    },
    {
      "matches": [
        "https://cloud.isurvey.mobi/*",
        "https://se-web-prodv2-dot-isurvey-se-gcp.as.r.appspot.com/*"
      ],
      "js": [
        "config-bridge.js",
        "resolver.js",
        "content.js",
        "feature-out-of-area-amount.js",
        "feature-out-of-hours-amount.js",
        "feature-deduct-amount.js",
        "feature-sub-area-checkbox.js",
        "feature-daily-check-amount.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://cloud.isurvey.mobi/*",
        "https://se-web-prodv2-dot-isurvey-se-gcp.as.r.appspot.com/*"
      ],
      "js": [
        "dashboard-badge.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/provinces.json",
        "data/amphurs.json",
        "data/tumbons.json"
      ],
      "matches": [
        "https://cloud.isurvey.mobi/*",
        "https://*.isurvey.mobi/*",
        "https://*.appspot.com/*"
      ]
    }
  ]
}
